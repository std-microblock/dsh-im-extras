node_modules/

# Build output is not tracked: the deployment builds the workspace before it
# packs a plugin (see `scripts/deploy.ps1` in the deployment repository), and a
# committed `dist` only ever drifts from `src`.
dist/
packages/*/client/client.js

# Generated per machine: points the plugins' `@deepseek-ai/*` imports at the
# harness checkout this machine builds (see `scripts/harness-tsconfig.mjs`).
tsconfig.harness.json
.harness-root

# Deployment residue.
.deploy/
*.tgz
*.log

{
  "name": "dsh-im-card",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive Feishu cards written as React-like TSX: a QuickJS VM per card, hooks, click callbacks, whole-VM snapshots that survive restarts, the im_send_card tool and satori-tsx blocks inside the streamed summary message.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skill",
    "types",
    "README.md"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p src/vm/tsconfig.json && node scripts/build-vm.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/vm/tsconfig.json",
    "test": "node scripts/build-vm.mjs && node --import ../../scripts/test-resolve.mjs --disable-warning=ExperimentalWarning --test --test-timeout=120000 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "quickjs-wasi": "3.6.2",
    "zod": "4.4.3",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/cordis-plugin-im-core": "*",
    "@deepseek-ai/dsh-im": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/cordis-plugin-im-core": {
      "optional": true
    },
    "@deepseek-ai/dsh-im": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}

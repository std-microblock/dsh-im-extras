{
  "name": "dsh-im-user-names",
  "version": "0.1.0",
  "private": true,
  "description": "Resolve and cache IM user display names (e.g. Feishu open_id -> name(open_id)) across messages, quotes, reactions, and card interactions without modifying dsh-im.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ../../scripts/test-resolve.mjs --test --test-timeout=120000 \"test/**/*.test.ts\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/cordis-plugin-im-core": "*",
    "@deepseek-ai/dsh-im": "*",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/schemastery": "*",
    "zod": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/cordis-plugin-im-core": { "optional": true },
    "@deepseek-ai/dsh-im": { "optional": true },
    "@deepseek-ai/dsh-storage-domain": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "zod": { "optional": true }
  }
}
